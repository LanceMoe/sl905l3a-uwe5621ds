# Auto detect text files and perform LF normalization
* text=auto
*.sh text eol=lf
# Unified-diff context prefixes spaces before tabs and blank context lines.
*.patch text eol=lf whitespace=-space-before-tab,-blank-at-eol
*.py text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.conf text eol=lf
*.service text eol=lf
packaging/cm311-wifi-load text eol=lf
